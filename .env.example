# Copy this file to .env and fill in your values. NEVER commit your real .env!

# Flask session signing key — set a long random string.
# Generate one with:  python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# App environment. "development" or "production".
# In production, ENV must be set AND secret-key + https SITE_URL are enforced.
ENV=development

# Local development: true turns on Flask's auto-reload debug server.
DEBUG=true

# Public base URL of the app. Used for OAuth redirects and secure cookies.
# Development: http://127.0.0.1:5001
# Production:  https://pdfweave.onrender.com
SITE_URL=http://127.0.0.1:5001

# Optional: write logs to a file (useful in production).
# LOG_FILE=logs/app.log

# ------------------------------------------------------------------
# Supabase (Backend-as-a-Service) — handles auth + database
# 1. Create a project at https://supabase.com/dashboard
# 2. Project Settings -> API: copy the Project URL and the anon public key
# 3. Paste them into .env (not this file), then restart the app.
# ------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key