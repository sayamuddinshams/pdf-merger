# ============================================================
# MergePDF — PRODUCTION environment template
# Copy this to .env on your production host and fill it in.
# NEVER commit real secrets. NEVER upload .env into the Docker image.
# ============================================================

# Flask session signing key — REQUIRED in production.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-long-random-string

# Must be exactly "production" (the app enforces secure config when it is).
ENV=production

# Public HTTPS URL (Cloudflare tunnel origin / your domain).
SITE_URL=https://your-domain.com

# Port for waitress (Windows host) or gunicorn (Docker/Linux).
PORT=8000

# Optional: file to write logs to.
LOG_FILE=logs/app.log

# ------------------------------------------------------------------
# Supabase (same values as development — Project Settings -> API)
# ------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key